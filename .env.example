# control-plane — LLM only, never Alpaca credentials
ANTHROPIC_API_KEY=
DATABASE_URL=              # cp_role connection string, Supavisor session mode (port 5432)

# execution — Alpaca only, never the Anthropic key
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER=true
EXEC_DATABASE_URL=         # exec_role connection string

# ops-web — SELECT-only, no Alpaca or Anthropic credentials
OPS_DATABASE_URL=          # ops_role connection string

APP_MODE=paper             # paper | live — drives which Postgres schema is used
