# ============================================================
# control-plane — LLM + Jev + DB read/write (cp_role)
# NEVER set ALPACA_KEY or ALPACA_SECRET here.
# ============================================================
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=             # Jev (TypeSafe AI) API key — sign up at typesafe.ai
DATABASE_URL=                 # cp_role Supavisor session-mode URL (port 5432, NOT 6543)

WATCH_SYMBOLS=AAPL,MSFT,NVDA,TSLA,SPY   # comma-separated tickers, no spaces
INITIAL_NAV=100000            # starting NAV in USD — must match Alpaca paper account equity
DAILY_SPEND_CAP_USD=2.00      # max LLM + Jev spend per day
ANTHROPIC_MODEL=claude-sonnet-4-6

RUN_ONCE=true                 # Railway cron mode — process exits after one run

# ============================================================
# execution — Alpaca + DB read/write (exec_role)
# NEVER set ANTHROPIC_API_KEY or TYPESAFE_API_KEY here.
# ============================================================
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER=true             # always true for the 30-day paper run
EXEC_DATABASE_URL=            # exec_role Supavisor session-mode URL (port 5432, NOT 6543)

WATCH_SYMBOLS=AAPL,MSFT,NVDA,TSLA,SPY   # must match control-plane
FRED_API_KEY=                 # optional — FRED VIX data; leave blank to skip

# ============================================================
# ops-web — SELECT-only (ops_role)
# ============================================================
OPS_DATABASE_URL=             # ops_role Supavisor session-mode URL

# ============================================================
# Shared
# ============================================================
NODE_ENV=production
APP_MODE=paper                # paper | live — guards against accidental live trading
